
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out project from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project'
            }
        }

        stage('Test') {
            steps {
                echo 'Running project tests'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment completed'
            }
        }
    }
}
